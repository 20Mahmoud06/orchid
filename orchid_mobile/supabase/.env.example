# Paymob TEST / sandbox configuration
# Copy this file to .env locally and fill in your TEST credentials.
# Never commit real credentials.

PAYMOB_SECRET_KEY=your_test_secret_key
PAYMOB_PUBLIC_KEY=your_test_public_key
PAYMOB_HMAC_SECRET=your_test_hmac_secret
PAYMOB_CARD_INTEGRATION_ID=000000
PAYMOB_BASE_URL=https://accept.paymob.com

# Optional:
# PAYMOB_NOTIFICATION_URL=https://your-project.supabase.co/functions/v1/paymob-webhook
# PAYMOB_REDIRECTION_URL=https://your-web-app.example/payment-return
